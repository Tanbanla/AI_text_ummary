    [ApiController]
    [Route("api/[controller]")]
    public class EquipBrowController: ControllerBase
    {
        private readonly UserDbContext _DbContext;
        public EquipBrowController(UserDbContext _DbContext)
        {
            this._DbContext = _DbContext;
        }
        [HttpGet("EquipBrowcode/{code}")]
        public async Task<IActionResult> GetByDayli(int code)
        {
            if (code==null)
            {
                return BadRequest("Nhập tên thiết bị");
            }

            var dayli = _DbContext.TM_EQUIP_BROW
                                   .Where(p => p.ID == code);
                         

            if (!dayli.Any())
            {
                return NotFound("Thiết bị không có trong hệ thống");
            }

            return Ok(dayli);
        }
        [HttpGet("EquipBrowName/{name2}")]
        public async Task<IActionResult> GetByName(string name2)
        {
            if (string.IsNullOrEmpty(name2))
            {
                return BadRequest("Nhập tên thiết bị.");
            }

            // Lấy mã thiết bị đã kiểm tra
            var checkedEquipmentCodes = await _DbContext.TM_EQUIP
                .Where(c => c.CHR_DECODE.ToUpper() == name2.ToUpper())
                .Select(c => c.CHR_EQUIP_CODE)
                .ToListAsync();

            // Lấy danh sách thiết bị theo mã
            var dayli = await _DbContext.TM_EQUIP_BROW
                .Where(p => (
                    checkedEquipmentCodes.Contains(p.CHR_EQUIP_CODE) ||
                    p.CHR_EQUIP_CODE.ToUpper() == name2.ToUpper())
                    && (p.BIT_END == null || p.BIT_END == false))
                .ToListAsync();

            if (!dayli.Any())
            {
                return NotFound("Không tìm thấy thiết bị trong hệ thống.");
            }

            // Lấy thiết bị cuối cùng trong danh sách
            var lastEquip = dayli.LastOrDefault();

            if (lastEquip == null)
            {
                return NotFound("Không tìm thấy thiết bị cuối cùng.");
            }

            return Ok(lastEquip);
        }
        [HttpPost]
        public async Task<IActionResult> PostDayli([FromBody] EquipBrow equipBrow)
        {
            if (equipBrow == null)
            {
                return BadRequest("Không được để trống."); 
            }

            try
            {
                _DbContext.TM_EQUIP_BROW.Add(equipBrow);
                await _DbContext.SaveChangesAsync();

                return Ok(equipBrow);
            }
            catch (DbUpdateException ex)
            {
                return StatusCode(500, "Lỗi khi lưu dữ liệu: " + ex.Message);
            }
            catch (Exception ex)
            {
                return StatusCode(500, "Đã xảy ra lỗi: " + ex.Message);
            }
        }
        [HttpPut("{id}")]
        public async Task<ActionResult<EquipBrow>> PutDayli(int id, EquipBrow dayli)
        {
            if (id != dayli.ID)
            {
                return BadRequest("Không được để trống thông tin");
            }
            _DbContext.Entry(dayli).State = EntityState.Modified;
            try
            {
                await _DbContext.SaveChangesAsync();
            }
            catch (DbUpdateConcurrencyException)
            {
                if (!_DbContext.TM_EQUIP_BROW.Any(e => e.ID == id))
                {
                    return NotFound("Lỗi vui lòng kiểm tra");
                }
                else
                {
                    throw;
                }

            }
            return Ok(dayli);
        }
    }
